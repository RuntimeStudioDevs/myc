# =============================================================================
# MYC — Variables de Entorno
# =============================================================================
# Copia este archivo como .env.local y completa los valores reales.
# .env.local está en .gitignore: nunca se sube al repositorio.
# No uses comillas ni espacios alrededor del signo =.
# =============================================================================

# ── Supabase Auth (Cliente SSR) ──────────────────────────────────────────────
# Prefijo NEXT_PUBLIC_* = visible en cliente y servidor.

# URL del proyecto Supabase.
# Pública. Se usa en cliente y servidor para conectar con Supabase.
# Dónde obtenerla: Supabase Dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública para interactuar con Supabase desde el cliente.
# Pública (safe for browser). Se usa en cliente y servidor.
# Dónde obtenerla: Supabase Dashboard → Project Settings → API Keys
#   → "anon public" (legacy) o "publishable key" (moderno).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Prisma / PostgreSQL (Conexión a Base de Datos) ──────────────────────────
# Secretos. Solo se usan en servidor / CLI. Nunca en frontend.
# Ambas se obtienen en Supabase Dashboard → Project Settings → Database.

# Cadena de conexión transaccional con pooler (sesión compartida).
# Usada por defecto en la aplicación Next.js (Prisma Client).
# Puerto típico con pooler: 6543.
DATABASE_URL=

# Cadena de conexión directa (sin pooler).
# Usada para migraciones Prisma (npx prisma migrate).
# Puerto típico directo: 5432.
DIRECT_DATABASE_URL=

# ── Supabase Admin (Service Role) ────────────────────────────────────────────
# Secreto crítico. Solo servidor. NUNCA en NEXT_PUBLIC_* ni en frontend.
# Esta clave tiene permisos administrativos totales y bypass RLS.
# Dónde obtenerla: Supabase Dashboard → Project Settings → API Keys
#   → "service_role" (legacy) o "secret key" (moderno, formato sb_secret_...).
# Riesgo: si se expone, cualquiera puede leer/escribir toda la base de datos.
SUPABASE_SERVICE_ROLE_KEY=

# ── Seed de Administrador Inicial ────────────────────────────────────────────
# Credenciales del usuario administrador que crea el seed script.
# Solo se usan al ejecutar: npm run seed:admin

# Email del usuario administrador inicial. Defínelo tú.
# Debe ser un email real si el proyecto requiere confirmación.
ADMIN_EMAIL=

# Contraseña del usuario administrador inicial. Defínela tú (debe ser fuerte).
# Mínimo 6 caracteres (requisito de Supabase Auth).
ADMIN_PASSWORD=
